# Copy to .env (git-ignored) and fill in. Never commit real keys.

# Model providers, tried in order. Bedrock is the target platform; the Anthropic API is the fallback.
LLM_PROVIDERS=bedrock,anthropic
EMBEDDING_PROVIDERS=bedrock,voyage

# Amazon Bedrock: uses the AWS CLI profile below (credentials stay in ~/.aws, mounted read-only).
AWS_PROFILE=beverage-alcohol-distributor
AWS_REGION=us-east-1

# Anthropic API (fallback for Claude). Create a key at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Voyage AI (fallback for embeddings). Create a key at https://dashboard.voyageai.com
VOYAGE_API_KEY=
